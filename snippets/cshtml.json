{
    "razor-layout": {
        "prefix": "razor-layout",
        "is_file_template": true,
        "body": [
            "<!DOCTYPE html>",
            "",
            "<html>",
            "<head>",
            "\t<meta name=\"viewport\" content=\"width=device-width\" />",
            "\t<title>@ViewBag.Title</title>",
            "</head>",
            "<body>",
            "\t<div>",
            "\t\t@RenderBody()",
            "\t</div>",
            "</body>",
            "</html>"
        ],
        "description": "Razor view layout page"
    },
    "razor-viewstart": {
        "prefix": "razor-viewstart",
        "is_file_template": true,
        "body": ["@{", "\tLayout = \"_Layout\";", "}"],
        "description": "Used to set the default layout page for razor views"
    },
    "razor-component": {
        "prefix": "razor-component",
        "is_file_template": true,
        "body": ["<h3>Component</h3>", "", "@code {", "\t$0", "}"],
        "description": "Razor empty view component"
    },
    "razor-page-empty": {
        "prefix": "razor-page",
        "is_file_template": true,
        "body": [
            "@page",
            "@model ${1:Namespace}.${TM_FILENAME_BASE}Model",
            "@{",
            "\t$0",
            "}"
        ],
        "description": "Empty Razor page"
    },
    "razor-page-separated": {
        "prefix": "razor-page-sep",
        "is_file_template": true,
        "body": [
            "@page",
            "@model ${1:Namespace}.${TM_FILENAME_BASE}Model",
            "$0"
        ],
        "description": "Empty Razor page with model and code behind in separate files"
    },
    "razor-page-standalone": {
        "prefix": "razor-page-single",
        "is_file_template": true,
        "body": [
            "@page",
            "@functions {",
            "\tpublic string? DayName { get; set; }",
            "\tpublic void OnGet()",
            "\t{",
            "\t\tViewData[\"Title\"] = \"Home page\";",
            "\t\tDayName = DateTime.Now.ToString(\"dddd\");",
            "\t}",
            "}",
            "<div class=\"jumbotron\">",
            "\t<h1 class=\"display-3\">Welcome to Razor Pages</h1>",
            "\t<p class=\"lead\">You can start to modify this file now!</p>",
            "\t<hr />",
            "\t<p>It's @DayName!</p>",
            "\t<p> This file was generated by the <a href=\"https://marketplace.visualstudio.com/items?itemName=kineticSnippet.add-items\">add-items</a> extension, and it is an example of a single file razor page! </p>",
            "\t<p>",
            "\t\t<a class=\"btn btn-primary\" href=\"https://github.com/kineticSnippet/AddItems\">",
            "\t\t\tVisit the github repo</a>",
            "\t</p>",
            "</div>"
        ],
        "description": "Empty Razor page, with model and code behind in a single file"
    }
}
