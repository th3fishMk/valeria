{
    "name": "valeria",
    "displayName": "valeria",
    "description": "Fish tooling for vscode",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "valeria.createFile",
                "title": "Create new file",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.class",
                "title": "Create Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.interface",
                "title": "Create Interface",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.enum",
                "title": "Create Enum",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.struct",
                "title": "Create Struct",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.abstract-class",
                "title": "Create Abstract Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.partial-class",
                "title": "Create Partial Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.record",
                "title": "Create Record",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-class",
                "title": "Create Unity Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-monoBehaviour",
                "title": "Create Unity MonoBehaviour",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-scriptable-object",
                "title": "Create Unity Scriptable Object",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-monoBehaviour-full",
                "title": "Create Unity MonoBehaviour Full",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-singleton",
                "title": "Create Unity Singleton",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-stateMachineBehaviour",
                "title": "Create Unity State Machine Behaviour",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-editorWindow",
                "title": "Create Unity Editor Window",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-customEditor",
                "title": "Create Unity Custom Editor",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-class",
                "title": "Create Legacy Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-interface",
                "title": "Create Legacy Interface",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-enum",
                "title": "Create Legacy Enum",
                "category": "Valeria"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "valeria.createFile",
                    "title": "Create File",
                    "category": "Valeria",
                    "group": "valeria"
                },
                {
                    "submenu": "valeria.csharp.menu",
                    "group": "valeria",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "valeria.csharp.menu": [
                {
                    "command": "valeria.create.csharp.unity-class",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-monoBehaviour",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-scriptable-object",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-monoBehaviour-full",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-singleton",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-stateMachineBehaviour",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-editorWindow",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.unity-customEditor",
                    "group": "_unity"
                },
                {
                    "command": "valeria.create.csharp.class",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.interface",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.enum",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.struct",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.abstract-class",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.partial-class",
                    "group": "_modern"
                },
                {
                    "command": "valeria.create.csharp.record",
                    "group": "_modern"
                },

                {
                    "command": "valeria.create.csharp.legacy-class",
                    "group": "legacy"
                },
                {
                    "command": "valeria.create.csharp.legacy-interface",
                    "group": "legacy"
                },
                {
                    "command": "valeria.create.csharp.legacy-enum",
                    "group": "legacy"
                }
            ]
        },
        "submenus": [
            {
                "id": "valeria.csharp.menu",
                "label": "Valeria C#"
            }
        ],
        "snippets": [
            {
                "language": "cpp",
                "path": "./snippets/cpp.json"
            },
            {
                "language": "csharp",
                "path": "./snippets/csharp.json"
            },
            {
                "language": "razor",
                "path": "./snippets/cshtml.json"
            },
            {
                "language": "javascript",
                "path": "./snippets/javascript.json"
            },
            {
                "language": "json",
                "path": "./snippets/json.json"
            },
            {
                "language": "markdown",
                "path": "./snippets/markdown.json"
            },
            {
                "language": "python",
                "path": "./snippets/python.json"
            },
            {
                "language": "typescript",
                "path": "./snippets/typescript.json"
            },
            {
                "language": "xml",
                "path": "./snippets/xml.json"
            },
            {
                "language": "yaml",
                "path": "./snippets/yaml.json"
            },
            {
                "language": "go",
                "path": "./snippets/go.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/mocha": "^10.0.10",
        "@types/node": "~22.19.19",
        "@types/vscode": "^1.120.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.27.7",
        "eslint": "^9.39.4",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1"
    }
}
