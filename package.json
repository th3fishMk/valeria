{
    "name": "valeria",
    "displayName": "valeria",
    "description": "Fish tooling for vscode",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "valeria.createFile",
                "title": "Create new file",
                "category": "Valeria"
            },
            {
                "command": "valeria.createFile.main",
                "title": "Create C++ Main",
                "category": "Valeria"
            },
            {
                "command": "valeria.createFile.class",
