                "category": "Valeria"
            },
            {
                "command": "valeria.createFile.struct",
                "title": "Create C++ Struct",
                "category": "Valeria"
            },
            {
                "command": "valeria.createFile.enum",
                "title": "Create C++ Enum",
                "category": "Valeria"
            },
            {
                "command": "valeria.createFile.template",
                "title": "Create C++ Template",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-class",
                "title": "Create Unity Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.unity-scriptable-object",
                "title": "Create Unity Scriptable Object",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.class",
                "title": "Create Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.interface",
                "title": "Create Interface",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.enum",
                "title": "Create Enum",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.struct",
                "title": "Create Struct",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.abstract-class",
                "title": "Create Abstract Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.partial-class",
                "title": "Create Partial Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.record",
                "title": "Create Record",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-class",
                "title": "Create Legacy Class",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-interface",
                "title": "Create Legacy Interface",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.csharp.legacy-enum",
                "title": "Create Legacy Enum",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-layout",
                "title": "Create Razor Layout",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-viewstart",
                "title": "Create Razor ViewStart",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-component",
                "title": "Create Razor Component",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-page-empty",
                "title": "Create Razor Page (Empty)",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-page-separated",
                "title": "Create Razor Page (Separated)",
                "category": "Valeria"
            },
            {
                "command": "valeria.create.razor.razor-page-standalone",
                "title": "Create Razor Page (Standalone)",
                "category": "Valeria"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "valeria.createFile",
                    "group": "_file-creation",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "submenu": "valeria.cpp.menu",
                    "group": "navigation",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "submenu": "valeria.csharp.menu",
                    "group": "navigation",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "submenu": "valeria.razor.menu",
                    "group": "navigation",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "valeria.cpp.menu": [
                {
                    "command": "valeria.createFile.main"
                },
                {
                    "command": "valeria.createFile.class"
                },
                {
                    "command": "valeria.createFile.struct"
                },
                {
                    "command": "valeria.createFile.enum"
                },
                {
                    "command": "valeria.createFile.template"
                }
            ],
            "valeria.csharp.menu": [
                {
                    "command": "valeria.create.csharp.unity-class"
                },
                {
                    "command": "valeria.create.csharp.unity-scriptable-object"
                },
                {
                    "command": "valeria.create.csharp.class"
                },
                {
                    "command": "valeria.create.csharp.interface"
                },
                {
                    "command": "valeria.create.csharp.enum"
                },
                {
                    "command": "valeria.create.csharp.struct"
                },
                {
                    "command": "valeria.create.csharp.abstract-class"
                },
                {
                    "command": "valeria.create.csharp.partial-class"
                },
                {
                    "command": "valeria.create.csharp.record"
                },
                {
                    "command": "valeria.create.csharp.legacy-class"
                },
                {
                    "command": "valeria.create.csharp.legacy-interface"
                },
                {
                    "command": "valeria.create.csharp.legacy-enum"
                }
            ],
            "valeria.razor.menu": [
                {
                    "command": "valeria.create.razor.razor-layout"
                },
                {
                    "command": "valeria.create.razor.razor-viewstart"
                },
                {
                    "command": "valeria.create.razor.razor-component"
                },
                {
                    "command": "valeria.create.razor.razor-page-empty"
                },
                {
                    "command": "valeria.create.razor.razor-page-separated"
                },
                {
                    "command": "valeria.create.razor.razor-page-standalone"
                }
            ]
        },
        "submenus": [
            {
                "id": "valeria.cpp.menu",
                "label": "Valeria C++"
            },
            {
                "id": "valeria.csharp.menu",
                "label": "Valeria C#"
            },
            {
                "id": "valeria.razor.menu",
                "label": "Valeria razor"
            }
        ],
        "snippets": [
            {
                "language": "cpp",
                "path": "./snippets/cpp.json"
            },
            {
                "language": "csharp",
                "path": "./snippets/csharp.json"
            },
            {
                "language": "razor",
                "path": "./snippets/cshtml.json"
            },
            {
                "language": "javascript",
                "path": "./snippets/javascript.json"
            },
            {
                "language": "json",
                "path": "./snippets/json.json"
            },
            {
                "language": "markdown",
                "path": "./snippets/markdown.json"
            },
            {
                "language": "python",
                "path": "./snippets/python.json"
            },
            {
                "language": "typescript",
                "path": "./snippets/typescript.json"
            },
            {
                "language": "xml",
                "path": "./snippets/xml.json"
            },
            {
                "language": "yaml",
                "path": "./snippets/yaml.json"
            },
            {
                "language": "go",
                "path": "./snippets/go.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/mocha": "^10.0.10",
        "@types/node": "~22.19.19",
        "@types/vscode": "^1.120.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.3",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    }
}
